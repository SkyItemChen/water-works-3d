{
  "name": "waterworks-3d",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "Waterworks 3D — a deterministic voxel water puzzle game",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node node_modules/esbuild/bin/esbuild scripts/verify-code.mts --bundle --platform=node --format=esm --outfile=.solver/verify.mjs --log-level=warning && node .solver/verify.mjs",
    "merge:scores": "node node_modules/esbuild/bin/esbuild scripts/merge-scores.mts --bundle --platform=node --format=esm --outfile=.solver/merge.mjs --log-level=warning && node .solver/merge.mjs",
    "gen:challenge": "node node_modules/esbuild/bin/esbuild scripts/gen-challenge.mts --bundle --platform=node --format=esm --outfile=.solver/gen.mjs --log-level=warning && node .solver/gen.mjs",
    "solve": "node node_modules/esbuild/bin/esbuild scripts/solve.mts --bundle --platform=node --format=esm --outfile=.solver/solve.mjs --log-level=warning && node .solver/solve.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "three": "^0.170.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
